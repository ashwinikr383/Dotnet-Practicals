@model FeedbackManagement.Models.Feedback

@{
    ViewData["Title"] = "Feedback Management";
}

<div class="container mt-4">
    <h2>Feedback Management System</h2>
    <p>Please share your feedback.</p>

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            @ViewBag.Message
        </div>
    }

    @using (Html.BeginForm("Index", "Feedback", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })

        <partial name="_FeedbackFields" model="Model" />

        <button type="submit" class="btn btn-primary">
            Submit Feedback
        </button>
    }
</div>
